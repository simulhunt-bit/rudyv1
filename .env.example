# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Identity Services client ID is browser-safe, but no client secret belongs here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side audience validation for Google ID tokens (usually the same client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
